{
  "extends": "./tsconfig",
  "compilerOptions": {
    "outDir": "dist/cjs",
    "rootDir": "./src",
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "allowImportingTsExtensions": false,
    "declaration": false,
    "noEmit": false
  },
  "include": ["src/**/*.ts"]
}
