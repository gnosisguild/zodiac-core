{
  "name": "@gnosis-guild/zodiac-core",
  "version": "4.0.1",
  "description": "Zodiac is a composable design philosophy and collection of standards for building DAO ecosystem tooling.",
  "author": "Auryn Macmillan <auryn@gnosisguild.org>",
  "license": "LGPL-3.0+",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./contracts/*": "./contracts/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.10.0"
  },
  "files": [
    "package.json",
    "LICENSE",
    "README.md",
    "dist",
    "contracts"
  ],
  "scripts": {
    "build": "hardhat compile && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json",
    "postbuild": "node postbuild.mjs",
    "clean": "rm -rf dist build typechain-types",
    "test": "hardhat test",
    "coverage": "hardhat --coverage test",
    "format": "yarn format:sol && yarn format:ts",
    "format:sol": "prettier --write --plugin=prettier-plugin-solidity ./contracts/**/*.sol",
    "format:ts": "prettier --write ./src/**/*.ts ./test/**/*.ts ./*.ts",
    "prepare": "yarn clean && yarn build",
    "prerelease": "yarn clean && yarn build"
  },
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gnosisguild/zodiac-core.git"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.10",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.7",
    "@nomicfoundation/hardhat-ignition": "3.1.4",
    "@nomicfoundation/hardhat-ignition-ethers": "3.1.4",
    "@nomicfoundation/hardhat-keystore": "3.0.8",
    "@nomicfoundation/hardhat-mocha": "3.0.18",
    "@nomicfoundation/hardhat-network-helpers": "3.0.7",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.4",
    "@nomicfoundation/hardhat-typechain": "3.0.8",
    "@nomicfoundation/hardhat-verify": "3.0.16",
    "@nomicfoundation/ignition-core": "3.1.4",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.19.17",
    "@types/semver": "7.7.1",
    "chai": "6.2.2",
    "hardhat": "3.4.4",
    "mocha": "11.7.5",
    "prettier": "3.8.3",
    "prettier-plugin-solidity": "2.3.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ethers": "6.16.0",
    "semver": "7.7.4"
  },
  "packageManager": "yarn@1.22.19+sha512.ff4579ab459bb25aa7c0ff75b62acebe576f6084b36aa842971cf250a5d8c6cd3bc9420b22ce63c7f93a0857bc6ef29291db39c3e7a23aab5adfd5a4dd6c5d71"
}
